{
  "name": "ecommerce-image-validator",
  "version": "0.1.0",
  "description": "Policy-driven, explainable validation for ecommerce product images",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "MODEL_LICENSING.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run publint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:real-world": "node scripts/real-world-smoke.mjs",
    "publint": "publint",
    "prepack": "npm run check"
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.0.6",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "publint": "^0.3.15",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.6"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "minimatch": "^11.0.1"
  },
  "keywords": [
    "ecommerce",
    "image",
    "validation",
    "computer-vision",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/arna051/ecommerce-image-validator.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
